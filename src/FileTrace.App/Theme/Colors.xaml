<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        寻迹 FileTrace 主题色板。
        风格：浅色、简洁、信息密度较高的桌面工具软件配色（类似 VSCode / Notion 的浅色主题），
        品牌主色沿用 FileTypeCatalog 中 "doc" 类型色 #2563EB（蓝），
        状态色沿用 IndexStatus 语义：绿=可用 橙=待更新 蓝=构建中 灰=离线 红=错误。
    -->

    <!-- ===== 中性色 / 背景层级 ===== -->
    <Color x:Key="ColorAppBackground">#F1F5F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#F8FAFC</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderStrong">#CBD5E1</Color>
    <Color x:Key="ColorDivider">#EEF2F6</Color>

    <!-- ===== 文本 ===== -->
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#64748B</Color>
    <Color x:Key="ColorTextTertiary">#94A3B8</Color>
    <Color x:Key="ColorTextOnPrimary">#FFFFFF</Color>

    <!-- ===== 品牌主色 ===== -->
    <Color x:Key="ColorPrimary">#2563EB</Color>
    <Color x:Key="ColorPrimaryHover">#1D4ED8</Color>
    <Color x:Key="ColorPrimaryPressed">#1E40AF</Color>
    <Color x:Key="ColorPrimarySoft">#EFF6FF</Color>

    <!-- ===== 状态色（对应 IndexStatus） ===== -->
    <Color x:Key="ColorStatusOk">#16A34A</Color>
    <Color x:Key="ColorStatusNeedsUpdate">#EA580C</Color>
    <Color x:Key="ColorStatusBuilding">#2563EB</Color>
    <Color x:Key="ColorStatusSourceUnavailable">#94A3B8</Color>
    <Color x:Key="ColorStatusError">#DC2626</Color>

    <!-- ===== 文件类型色块（与 FileTypeCatalog 保持一致） ===== -->
    <Color x:Key="ColorTypeDoc">#2563EB</Color>
    <Color x:Key="ColorTypeXls">#059669</Color>
    <Color x:Key="ColorTypePdf">#DC2626</Color>
    <Color x:Key="ColorTypePpt">#EA580C</Color>
    <Color x:Key="ColorTypeMd">#0891B2</Color>
    <Color x:Key="ColorTypeTxt">#64748B</Color>
    <Color x:Key="ColorTypeCode">#7C3AED</Color>
    <Color x:Key="ColorTypeHtml">#DB2777</Color>
    <Color x:Key="ColorTypeJson">#B45309</Color>

    <!-- ===== 高亮命中片段（搜索结果里的 <mark>） ===== -->
    <Color x:Key="ColorHighlightBackground">#FEF08A</Color>
    <Color x:Key="ColorHighlightText">#7C2D12</Color>

    <!-- ===== Brush 封装（XAML 里直接绑定 Brush，避免每处都写 Color 转换） ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorAppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource ColorDivider}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource ColorTextOnPrimary}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource ColorPrimaryPressed}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource ColorPrimarySoft}" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource ColorStatusOk}" />
    <SolidColorBrush x:Key="StatusNeedsUpdateBrush" Color="{StaticResource ColorStatusNeedsUpdate}" />
    <SolidColorBrush x:Key="StatusBuildingBrush" Color="{StaticResource ColorStatusBuilding}" />
    <SolidColorBrush x:Key="StatusSourceUnavailableBrush" Color="{StaticResource ColorStatusSourceUnavailable}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource ColorStatusError}" />

    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="{StaticResource ColorHighlightBackground}" />
    <SolidColorBrush x:Key="HighlightTextBrush" Color="{StaticResource ColorHighlightText}" />

</ResourceDictionary>
