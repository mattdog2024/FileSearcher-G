<UserControl x:Class="FileTrace.App.Views.Controls.NewIndexDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileTrace.App.ViewModels"
             xmlns:models="clr-namespace:FileTrace.App.Models"
             mc:Ignorable="d"
             d:DesignWidth="520" d:DesignHeight="640"
             d:DataContext="{d:DesignInstance Type=vm:NewIndexDialogViewModel}">

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="10"
            Width="520"
            MaxHeight="680"
            Effect="{DynamicResource DropShadowEffectDefault}">
        <Border.Resources>
            <DropShadowEffect x:Key="DropShadowEffectDefault" BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                <TextBlock Text="新建索引" Style="{StaticResource TextTitle}" />
            </Border>

            <!-- 表单内容 -->
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                <StackPanel>
                    <TextBlock Text="索引名称" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource DefaultTextBoxStyle}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如：工作文档、项目代码" />

                    <TextBlock Text="源目录（要建立索引的文件夹）" Style="{StaticResource TextCaption}" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：D:\Documents"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="浏览…"
                                Click="OnBrowseRootPath" />
                    </Grid>

                    <TextBlock Text="索引存储位置（可与源盘不同）" Style="{StaticResource TextCaption}" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：D:\FileTraceIndex\work"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="浏览…"
                                Click="OnBrowseStoragePath" />
                    </Grid>
                    <TextBlock Text="即使源盘拔出，只要索引文件还在这个位置，就可以离线搜索"
                               Style="{StaticResource TextMicro}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <!-- 文件类型勾选 -->
                    <Grid Margin="0,18,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="包含的文件类型" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="全选" Foreground="{StaticResource PrimaryBrush}" FontSize="11"
                                       Cursor="Hand" MouseLeftButtonUp="OnSelectAllTypes" />
                            <TextBlock Text=" / " Style="{StaticResource TextMicro}" />
                            <TextBlock Text="清空" Foreground="{StaticResource PrimaryBrush}" FontSize="11"
                                       Cursor="Hand" MouseLeftButtonUp="OnClearAllTypes" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding FileTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FileTypeOption}">
                                <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                                          Content="{Binding DisplayLabel}"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="0,0,16,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource HDividerStyle}" />

                    <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                              Content="启用增量索引（推荐，后续只扫描变化的文件）"
                              IsChecked="{Binding IncrementalEnabled}"
                              Margin="0,4" />

                    <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                              Content="启用 OCR 识别扫描版 PDF / 图片（可选，会显著降低索引速度）"
                              IsChecked="{Binding OcrEnabled}"
                              Margin="0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="单文件内容提取大小上限（MB）：" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource DefaultTextBoxStyle}"
                                 Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding MaxFileSizeMbText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Padding="20,14" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="取消"
                            Click="OnCancelClicked"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="创建索引"
                            IsEnabled="{Binding CanConfirm}"
                            Click="OnConfirmClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
