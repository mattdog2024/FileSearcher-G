<UserControl x:Class="FileTrace.App.Views.Controls.IndexProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileTrace.App.ViewModels"
             xmlns:conv="clr-namespace:FileTrace.App.Converters"
             mc:Ignorable="d"
             d:DesignWidth="270"
             d:DataContext="{d:DesignInstance Type=vm:IndexProfileCardViewModel}">

    <UserControl.Resources>
        <conv:ResourceKeyToBrushConverter x:Key="ResKeyToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RootPath}"
                               Style="{StaticResource TextCaption}"
                               Margin="0,2,0,0"
                               ToolTip="{Binding RootPath}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding RemoveCommand}"
                        ToolTip="删除此索引">
                    <TextBlock Text="&#10005;" FontSize="10" Opacity="0.5" />
                </Button>
            </Grid>

            <!-- 状态行 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrushKey, Converter={StaticResource ResKeyToBrush}}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" Margin="6,0,0,0" />
                <TextBlock Text=" · " Style="{StaticResource TextMicro}" />
                <TextBlock Text="{Binding FileCountDisplay}" Style="{StaticResource TextCaption}" />
                <TextBlock Text=" 个文件 · " Style="{StaticResource TextCaption}" />
                <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource TextCaption}" />
            </StackPanel>

            <TextBlock Text="{Binding LastUpdatedDisplay, StringFormat=最近更新: {0}}"
                       Style="{StaticResource TextMicro}"
                       Margin="0,4,0,0" />

            <!-- 构建进度条（仅 IsBuilding 时显示） -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="4"
                             Minimum="0" Maximum="100"
                             Value="{Binding BuildProgressPercent, Mode=OneWay}"
                             Background="{StaticResource DividerBrush}"
                             Foreground="{StaticResource PrimaryBrush}"
                             BorderThickness="0" />
                <TextBlock Text="{Binding BuildProgressText}"
                           Style="{StaticResource TextMicro}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 操作按钮行 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="11"
                        Command="{Binding TogglePauseCommand}"
                        Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"
                        Content="{Binding PauseButtonLabel}" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="11"
                        Margin="8,0,0,0"
                        Command="{Binding RebuildCommand}"
                        Content="重建索引" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
