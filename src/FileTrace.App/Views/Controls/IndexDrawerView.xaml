<UserControl x:Class="FileTrace.App.Views.Controls.IndexDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileTrace.App.ViewModels"
             xmlns:conv="clr-namespace:FileTrace.App.Converters"
             xmlns:local="clr-namespace:FileTrace.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="16,14" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="寻迹" Style="{StaticResource TextTitleLarge}" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text=" FileTrace" Style="{StaticResource TextTitleLarge}" Margin="2,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 索引卡片列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
            <StackPanel>
                <TextBlock Text="索引管理" Style="{StaticResource TextSubtitle}" Margin="4,0,0,10" />

                <ItemsControl ItemsSource="{Binding IndexProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IndexProfileCardViewModel}">
                            <local:IndexProfileCard Margin="0,0,0,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="尚未创建任何索引"
                           Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：新建索引按钮 -->
        <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding OpenNewIndexDialogCommand}">
                <TextBlock Text="+ 新建索引" HorizontalAlignment="Center" />
            </Button>
        </Border>
    </Grid>
</UserControl>
