<UserControl x:Class="FileTrace.App.Views.Controls.AboutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileTrace.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="380" d:DesignHeight="320"
             d:DataContext="{d:DesignInstance Type=vm:AboutDialogViewModel}">

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="10"
            Width="380"
            Effect="{DynamicResource DropShadowEffectDefault}">
        <Border.Resources>
            <DropShadowEffect x:Key="DropShadowEffectDefault" BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Resources>

        <StackPanel Margin="24,24,24,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="寻迹" Style="{StaticResource TextTitleLarge}" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text=" FileTrace" Style="{StaticResource TextTitleLarge}" Margin="2,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding VersionText}"
                       Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,16" />

            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource TextBody}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <Border Style="{StaticResource HDividerStyle}" Margin="0,0,0,16" />

            <TextBlock Text="遇到问题？"
                       Style="{StaticResource TextSubtitle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="程序运行中的关键事件与错误都会记录到本地日志文件，反馈问题时可以把日志文件夹一并发给开发者。"
                       Style="{StaticResource TextCaption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Content="打开日志文件夹"
                    HorizontalAlignment="Stretch"
                    Command="{Binding OpenLogsFolderCommand}"
                    Margin="0,0,0,16" />

            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Content="关闭"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Border>
</UserControl>
